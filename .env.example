# Database (arquivo SQLite dentro do volume montado no container)
DATABASE_URL="file:/app/data/db.sqlite"

# Auth
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"
SESSION_COOKIE_NAME="role_rankeado_session"
SESSION_MAX_AGE_DAYS=180

# Uploads
UPLOADS_DIR="/app/data/uploads"
MAX_UPLOAD_SIZE_MB=8

# Bootstrap do primeiro admin (veja prisma/seed.mjs)
# Sem isso, ninguém consegue logar no primeiro deploy.
SEED_ADMIN_PHONE="+5511999999999"
SEED_ADMIN_NAME="Admin"

# Runtime
NODE_ENV="production"
PORT=3000
